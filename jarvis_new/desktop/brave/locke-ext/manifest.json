{
  "manifest_version": 3,
  "name": "Locke Deck",
  "version": "1.0.0",
  "description": "Locke ASCII new tab, page transitions and tab console for Brave.",
  "chrome_url_overrides": { "newtab": "ntp/index.html" },
  "action": { "default_popup": "popup/popup.html", "default_title": "Locke" },
  "icons": { "16": "icons/16.png", "48": "icons/48.png", "128": "icons/128.png" },
  "permissions": ["topSites", "history", "bookmarks", "sessions", "downloads", "tabs", "storage", "system.cpu", "system.memory", "system.storage", "favicon"],
  "content_scripts": [{
    "matches": ["http://*/*", "https://*/*"],
    "js": ["fx/wipe.js"],
    "run_at": "document_start",
    "all_frames": false
  }],
  "web_accessible_resources": [{ "resources": ["_favicon/*"], "matches": ["<all_urls>"], "extension_ids": ["*"] }]
}
