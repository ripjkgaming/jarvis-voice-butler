{
  "manifest_version": 3,
  "name": "Locke Theme",
  "version": "1.0.0",
  "description": "Locke ASCII dark-blue theme: deep bg, cyan text, amber accent.",
  "theme": {
    "images": {
      "theme_frame": "images/frame.png",
      "theme_frame_inactive": "images/frame.png",
      "theme_toolbar": "images/toolbar.png",
      "theme_ntp_background": "images/ntp.png"
    },
    "colors": {
      "frame": [2, 9, 15],
      "frame_inactive": [3, 12, 20],
      "frame_incognito": [10, 8, 4],
      "frame_incognito_inactive": [12, 10, 6],
      "toolbar": [6, 24, 35],
      "tab_text": [216, 246, 255],
      "tab_background_text": [95, 227, 255],
      "tab_background_text_inactive": [60, 150, 170],
      "bookmark_text": [95, 227, 255],
      "ntp_background": [2, 9, 15],
      "ntp_text": [216, 246, 255],
      "ntp_link": [95, 227, 255],
      "ntp_header": [6, 24, 35],
      "omnibox_background": [2, 9, 15],
      "omnibox_text": [216, 246, 255],
      "button_background": [6, 24, 35],
      "toolbar_button_icon": [95, 227, 255],
      "control_background": [6, 24, 35],
      "toolbar_text": [216, 246, 255],
      "toolbar_top_separator": [255, 179, 71],
      "toolbar_vertical_separator": [20, 70, 90]
    },
    "tints": {
      "buttons": [0.52, 0.65, 0.78]
    },
    "properties": {
      "ntp_background_alignment": "center",
      "ntp_background_repeat": "repeat",
      "ntp_logo_alternate": 1
    }
  }
}
