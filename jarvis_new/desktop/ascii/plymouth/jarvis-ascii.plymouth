[Plymouth Theme]
Name=Jarvis ASCII
Description=Cinematic J.A.R.V.I.S boot in ASCII glyphs: flare, warp tunnel, reactor drop with shockwave, HUD panels, helmet scan, block wordmark, grain + vignette
ModuleName=script

[script]
ImageDir=/usr/share/plymouth/themes/jarvis-ascii
ScriptFile=/usr/share/plymouth/themes/jarvis-ascii/jarvis-ascii.script
