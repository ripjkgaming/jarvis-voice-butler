// Jarvis ASCII boot. Frames come from gen_frames.py: 0..29 play once, 30..89 loop.
// Password values are never displayed; prompts pause the animation.
Window.SetBackgroundTopColor(0.008, 0.035, 0.059);
Window.SetBackgroundBottomColor(0.008, 0.035, 0.059);
screen_w = Window.GetWidth();
screen_h = Window.GetHeight();
scale = Math.Min(screen_w / 1920, screen_h / 1080);
if (scale > 1) scale = Math.Int(scale);
INTRO = 30;
LOOP = 60;

global.frames = [];
for (i = 0; i < INTRO + LOOP; i++) {
    global.frames[i] = Image("frame-" + i + ".png").Scale(594 * scale, 504 * scale);
}
global.bars = [];
for (i = 0; i <= 32; i++) {
    global.bars[i] = Image("bar-" + i + ".png").Scale(306 * scale, 18 * scale);
}
global.scene = Sprite(global.frames[0]);
global.scene.SetX((screen_w - 594 * scale) / 2);
global.scene.SetY((screen_h - 504 * scale) / 2 - 40 * scale);
global.scene.SetZ(10);
global.bar = Sprite(global.bars[0]);
global.bar.SetX((screen_w - 306 * scale) / 2);
global.bar.SetY((screen_h + 504 * scale) / 2 + 10 * scale);
global.bar.SetZ(20);

global.frame = 0;
global.prompt = 0;
Plymouth.SetRefreshRate(15);

global.prompt_label = Sprite();
global.prompt_value = Sprite();
global.message = Sprite();
global.prompt_label.SetZ(30);
global.prompt_value.SetZ(30);
global.message.SetZ(30);

fun set_label(sprite, text, y, r, g, b) {
    label_image = Image.Text(text, r, g, b, 1, "Monospace 14");
    sprite.SetImage(label_image);
    sprite.SetX((screen_w - label_image.GetWidth()) / 2);
    sprite.SetY(y);
    sprite.SetOpacity(1);
}

fun refresh_callback() {
    if (global.prompt == 0) {
        global.frame = global.frame + 1;
        if (global.frame >= INTRO + LOOP) global.frame = INTRO;
        global.scene.SetImage(global.frames[global.frame]);
    }
}
fun progress_callback(duration, progress) {
    n = Math.Int(Math.Max(0, Math.Min(1, progress)) * 32);
    global.bar.SetImage(global.bars[n]);
}
fun clear_prompt() {
    global.prompt_label.SetOpacity(0);
    global.prompt_value.SetOpacity(0);
    global.prompt = 0;
    global.bar.SetOpacity(1);
}
fun display_password_callback(prompt, bullets) {
    global.prompt = 1;
    global.bar.SetOpacity(0);
    set_label(global.prompt_label, "[ " + prompt + " ]", screen_h * 0.8, 1.0, 0.70, 0.28);
    masked = "";
    for (i = 0; i < Math.Min(bullets, 64); i++) { masked += "#"; }
    set_label(global.prompt_value, "> " + masked + "_", screen_h * 0.85, 0.37, 0.89, 1.0);
}
fun display_question_callback(prompt, entry) {
    global.prompt = 1;
    global.bar.SetOpacity(0);
    set_label(global.prompt_label, "[ " + prompt + " ]", screen_h * 0.8, 1.0, 0.70, 0.28);
    set_label(global.prompt_value, "> " + entry + "_", screen_h * 0.85, 0.37, 0.89, 1.0);
}
fun message_callback(text) {
    set_label(global.message, ":: " + text, screen_h * 0.92, 0.50, 0.65, 0.72);
}
fun hide_message_callback(text) { global.message.SetOpacity(0); }
Plymouth.SetRefreshFunction(refresh_callback);
Plymouth.SetBootProgressFunction(progress_callback);
Plymouth.SetDisplayNormalFunction(clear_prompt);
Plymouth.SetDisplayPasswordFunction(display_password_callback);
Plymouth.SetDisplayQuestionFunction(display_question_callback);
Plymouth.SetMessageFunction(message_callback);
Plymouth.SetHideMessageFunction(hide_message_callback);
