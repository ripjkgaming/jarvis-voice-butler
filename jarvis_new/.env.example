LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
# Local dev on your own machine: unlocks email/system/device tools
# (the worker refuses them without this, by design, for cloud deploys).
JARVIS_LOCAL=1
# Wake word ("hey Jarvis") is fully offline via openWakeWord: no account,
# no key. Listener runs from the dedicated venv: .venv-wake/bin/python
# src/wake_client.py. Optional sensitivity override (default 0.5).
# JARVIS_WAKE_THRESHOLD=0.5
# Web search that bot walls can't stop: free 2k queries/mo key at
# https://search.brave.com/api — no key = keyless fallbacks only.
# BRAVE_API_KEY=
# You.com Search API: LLM-ready results, free $5/mo credits at
# https://you.com/platform/api-keys — top search priority when set.
# YDC_API_KEY=
# Semantic intent routing via Needle 2 (14MB offline tool-calling model):
# install with `uv sync --extra needle`, then set JARVIS_NEEDLE=1.
# Paraphrases ("crank it up") map to tools with calibrated confidence;
# anything unsure falls back to the existing tiers. Disable with 0.
# JARVIS_NEEDLE=1
# Voice pipeline: realtime (default, Gemini Live on your AI Studio key),
# local (LiveKit Cloud Inference STT/LLM + Piper voice), or direct
# (fully cloud-free for a local livekit-server: Silero VAD + local
# whisper ears, Gemini-direct brains, Piper mouth — needs GOOGLE_API_KEY).
# JARVIS_PIPELINE=realtime
# Local whisper size for the direct pipeline (tiny/base/small/medium,
# default base; weights already in the HF cache). CPU int8 by default;
# JARVIS_WHISPER_DEVICE=cuda + JARVIS_WHISPER_COMPUTE=float16 if ctranslate2
# ever grows CUDA libs on this box.
# JARVIS_WHISPER_MODEL=base
# Note: JARVIS_TTS=<cloud voice> rides LiveKit Inference — Cloud only.
# Under realtime/direct pipelines the local Piper voice always serves.
# Optional LoRA-tuned weights for the Jarvis vocabulary
# (`needle finetune` + `needle build`): JARVIS_NEEDLE_WEIGHTS=jarvis.cact
# Home-dir override for all Jarvis state (~/.jarvis by default). Set this
# when embedding in a desktop app with a sandboxed/virtualized home.
# JARVIS_HOME=
# Desktop-shell bridge: stdlib loopback control plane for tray/overlay UIs
# (`uv run python src/bridge.py`). Endpoints: /health /status /actions
# /sys /config — presence flags only, never secret values.
# JARVIS_BRIDGE_PORT=4317
# Optional bearer token for the bridge (constant-time compare).
# JARVIS_BRIDGE_TOKEN=
