LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
# Local dev on your own machine: unlocks email/system/device tools
# (the worker refuses them without this, by design, for cloud deploys).
JARVIS_LOCAL=1
# Headless backend workers reuse `codex login` with your ChatGPT account.
# Uses the desktop-bundled CLI if it is absent from a background service's PATH.
# JARVIS_CODEX_BIN=/path/to/codex
# Sol balances speed and capability; Luna handles short, frequent tasks.
# JARVIS_CHATGPT=1
# JARVIS_CHATGPT_BACKEND_MODEL=gpt-6.1-sol
# JARVIS_CHATGPT_RESEARCH_MODEL=gpt-6.1-sol
# JARVIS_CHATGPT_FAST_MODEL=gpt-6-luna
# JARVIS_CHATGPT_REASONING=medium
# JARVIS_CHATGPT_FAST_REASONING=low
# Wake word ("hey Jarvis") is fully offline via openWakeWord: no account,
# no key. Listener runs from the dedicated venv: .venv-wake/bin/python
# src/wake_client.py. Optional sensitivity override (default 0.5).
# JARVIS_WAKE_THRESHOLD=0.5
# Built-in mic hardware gain cap in dB, applied at wake-client start (default 0;
# the driver ships +18 dB, which clips loud rooms). off = leave the mixer alone.
# JARVIS_DMIC_GAIN_DB=0
# Web search that bot walls can't stop: free 2k queries/mo key at
# https://search.brave.com/api — no key = keyless fallbacks only.
# BRAVE_API_KEY=
# You.com Search API: LLM-ready results, free $5/mo credits at
# https://you.com/platform/api-keys — top search priority when set.
# YDC_API_KEY=
# Semantic intent routing via Needle 2 (14MB offline tool-calling model):
# install with `uv sync --extra needle`, then set JARVIS_NEEDLE=1.
# Paraphrases ("crank it up") map to tools with calibrated confidence;
# anything unsure falls back to the existing tiers. Disable with 0.
# JARVIS_NEEDLE=1
# Voice pipeline: realtime (default, Gemini Live on your AI Studio key),
# local (LiveKit Cloud Inference STT/LLM + Piper voice), or direct
# (fully cloud-free for a local livekit-server: Silero VAD + local
# whisper ears, Gemini-direct brains, Piper mouth — needs GOOGLE_API_KEY).
# JARVIS_PIPELINE=realtime
# English-only local Whisper for the direct pipeline (base.en default).
# Legacy tiny/base/small/medium select their .en equivalents. CPU int8;
# JARVIS_WHISPER_DEVICE=cuda + JARVIS_WHISPER_COMPUTE=float16 if ctranslate2
# ever grows CUDA libs on this box.
# Measured on this box (Phase 5, 10 Piper fixtures, digit-blind WER):
# tiny = fast but deaf on names/mute (mean WER 0.21, 7.8s/10utts);
# base = the knee (WER 0.000, p50 turn 1.3s, 13.8s/10utts);
# small = identical accuracy to base at ~3x the time (parity proven).
# Recommendation: base everywhere; tiny only for weak boxes.
# JARVIS_WHISPER_MODEL=base.en
# JARVIS_SPOT_MODEL=base.en
# Note: JARVIS_TTS=<cloud voice> rides LiveKit Inference — Cloud only.
# Under realtime/direct pipelines the local Piper voice always serves.
# Optional LoRA-tuned weights for the Jarvis vocabulary
# (`needle finetune` + `needle build`): JARVIS_NEEDLE_WEIGHTS=jarvis.cact
# Home-dir override for all Jarvis state (~/.jarvis by default). Set this
# when embedding in a desktop app with a sandboxed/virtualized home.
# JARVIS_HOME=
# Desktop-shell bridge: stdlib loopback control plane for tray/overlay UIs
# (`uv run python src/bridge.py`). Endpoints: /health /status /actions
# /sys /config — presence flags only, never secret values.
# JARVIS_BRIDGE_PORT=4317
# Optional bearer token for the bridge (constant-time compare).
# JARVIS_BRIDGE_TOKEN=
# Phone app (JarvisLink over Tailscale): bind the tailnet IP (or 0.0.0.0)
# and SET A TOKEN — the bridge refuses public binds without one.
# JARVIS_BRIDGE_BIND=100.77.6.93
# JARVIS_BRIDGE_TOKEN=<openssl rand -hex 32, stored 0600, also typed into app>
# Remote-mic hotword uplink (src/mic_uplink.py, wake venv): same bind rule
# (loopback default, token not needed — tailnet + WAKE-only protocol).
# JARVIS_MIC_PORT=4318
# JARVIS_MIC_BIND=100.77.6.93
# Phone-safe app launcher additions for POST /tool open_app, JSON:
# JARVIS_APP_MAP={"spotify": ["spotify"]}
# Phone voice transcription: English-only, base.en default for accuracy.
# JARVIS_PHONE_WHISPER=base.en
# All local Whisper paths force language=en and task=transcribe.
# Realtime captions come from Gemini native audio, not these weights.
# Proactive voice policy (background watcher + morning briefing): the
# watcher speaks only outside quiet hours (default 22:00-07:00, overnight
# wrap — held notes queue and flush after quiet, never wake you), at most
# 3 deliveries/day (safety-critical battery alerts bypass the cap but are
# logged), routine notes batch every 30 min, repeats dedupe for 1 h.
# Every decision is reason-coded to ~/.jarvis/actions.log (category
# "proactive"/"briefing"). The headless briefing also skips empty
# sections, caps spoken text at ~600 chars, and dedupes repeats.
# JARVIS_QUIET_HOURS=22:00-07:00
# JARVIS_PROACTIVE_MAX_PER_DAY=3
# Explicit one-shot reminders/calls run in the bridge, independently of
# passive proactivity. Restart bridge + voice agent after installing changes.
# The computer must be running; reminders use desktop notification/speech.
# Calls require native JarvisLink's Receive Jarvis calls listener + Tailscale.
# JARVIS_SCHEDULED_TASKS=1
# JARVIS_TZ=Asia/Singapore
# Mic suppression defaults to the lower-CPU GTCRN model; optional heavier
# DPDFNet remains available. "off" disables suppression altogether.
JARVIS_DENOISE=gtcrn

# Headless YouTube MP4 downloads. Requires Node >=22 and ffmpeg/ffprobe.
# Direct uses the existing local Brave session; "off" disables cookie use.
JARVIS_YOUTUBE_BACKEND=direct
JARVIS_YOUTUBE_COOKIES_BROWSER=brave
# Mercury Decide (OpenRouter Decisions API, inception/mercury-decide:free): ~0.6s
# yes/no + choice classifier used for triage (email urgency/scam) before ChatGPT.
# Uses OPENROUTER_API_KEY (env, $JARVIS_HOME/keys.env or opencode auth).
# Key limits on this account: 1000 free-model requests/day, $1/month spend cap
# (the :free model costs $0); 429/402 falls back to ChatGPT automatically.
# JARVIS_MERCURY=…   (0 disables)
# JARVIS_DECIDE_MODEL=…
