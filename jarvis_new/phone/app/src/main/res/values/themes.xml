<resources>
    <style name="Theme.JarvisLink" parent="Theme.Material3.Dark.NoActionBar">
        <item name="colorPrimary">#5FE3FF</item>
        <item name="colorOnPrimary">#05070D</item>
        <item name="android:windowBackground">#000000</item>
        <!-- v1.6: every element HUD-styled by default. -->
        <item name="materialButtonStyle">@style/Widget.JarvisLink.HudButton</item>
        <item name="editTextStyle">@style/Widget.JarvisLink.HudField</item>
        <item name="android:textViewStyle">@style/Widget.JarvisLink.HudText</item>
        <item name="alertDialogTheme">@style/ThemeOverlay.JarvisLink.HudDialog</item>
    </style>

    <!-- Translucent outlined HUD button: hairline cyan, cyan ripple. -->
    <style name="Widget.JarvisLink.HudButton" parent="Widget.Material3.Button.OutlinedButton">
        <item name="strokeColor">#661FD5F9</item>
        <item name="strokeWidth">1dp</item>
        <item name="rippleColor">#331FD5F9</item>
        <item name="android:textColor">#1FD5F9</item>
        <item name="cornerRadius">10dp</item>
        <item name="android:fontFamily">monospace</item>
        <item name="android:textSize">13sp</item>
    </style>

    <!-- Danger variant (SOS, lock): translucent red. -->
    <style name="Widget.JarvisLink.HudButton.Red" parent="Widget.JarvisLink.HudButton">
        <item name="strokeColor">#AAFF3B30</item>
        <item name="rippleColor">#55FF3B30</item>
        <item name="android:textColor">#FF8A80</item>
    </style>

    <!-- Translucent HUD text field. -->
    <style name="Widget.JarvisLink.HudField" parent="Widget.AppCompat.EditText">
        <item name="android:textColor">#E8F6FF</item>
        <item name="android:textColorHint">#5A7A8C</item>
        <item name="android:fontFamily">monospace</item>
        <item name="android:textSize">14sp</item>
        <item name="android:background">@drawable/hud_field</item>
        <item name="android:padding">12dp</item>
    </style>

    <!-- HUD body text everywhere (lists, statuses, labels). -->
    <style name="Widget.JarvisLink.HudText" parent="android:Widget.TextView">
        <item name="android:textColor">#E8F6FF</item>
        <item name="android:fontFamily">monospace</item>
    </style>

    <!-- Dark translucent dialogs. -->
    <style name="ThemeOverlay.JarvisLink.HudDialog" parent="ThemeOverlay.Material3.MaterialAlertDialog">
        <item name="colorSurface">#E60A1A2E</item>
        <item name="alertDialogStyle">@style/Widget.JarvisLink.HudAlertDialog</item>
    </style>

    <style name="Widget.JarvisLink.HudAlertDialog" parent="MaterialAlertDialog.Material3">
        <item name="backgroundTint">#E60A1A2E</item>
    </style>
</resources>
