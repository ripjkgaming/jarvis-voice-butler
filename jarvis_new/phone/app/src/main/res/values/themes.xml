<resources>
    <!--
    Desktop HUD look (jarvis_new/frontend/styles/globals.css): near-black navy,
    pale-cyan Commit Mono text, cyan hairlines, glass panels, state colours.
    Everything is driven from here so layouts stay style-free (LayoutIdsTest).
    -->
    <style name="Theme.JarvisLink" parent="Theme.Material3.Dark.NoActionBar">
        <item name="colorPrimary">@color/hud_cyan</item>
        <item name="colorOnPrimary">@color/hud_bg</item>
        <item name="colorPrimaryContainer">@color/hud_wash</item>
        <item name="colorOnPrimaryContainer">@color/hud_text_bright</item>
        <item name="colorSecondary">@color/hud_cyan_soft</item>
        <item name="colorOnSecondary">@color/hud_bg</item>
        <item name="colorTertiary">@color/hud_think</item>
        <item name="colorError">@color/hud_alert</item>
        <item name="colorSurface">@color/hud_bg_raised</item>
        <item name="colorOnSurface">@color/hud_text</item>
        <item name="colorSurfaceVariant">@color/hud_field</item>
        <item name="colorOnSurfaceVariant">@color/hud_text_dim</item>
        <item name="colorOutline">@color/hud_line_strong</item>
        <item name="android:colorBackground">@color/hud_bg</item>
        <item name="colorControlNormal">@color/hud_line_strong</item>
        <item name="colorControlActivated">@color/hud_cyan</item>
        <item name="colorControlHighlight">@color/hud_glow</item>
        <item name="android:textColorPrimary">@color/hud_text</item>
        <item name="android:textColorSecondary">@color/hud_text_dim</item>
        <item name="android:textColorHint">@color/hud_text_faint</item>
        <item name="android:textColorHighlight">@color/hud_glow</item>

        <item name="android:windowBackground">@drawable/hud_window_bg</item>
        <item name="android:statusBarColor">@color/hud_bg_raised</item>
        <item name="android:navigationBarColor">@color/hud_bg</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:fontFamily">@font/commit_mono</item>
        <item name="fontFamily">@font/commit_mono</item>

        <item name="android:textViewStyle">@style/Widget.Hud.TextView</item>
        <item name="materialButtonStyle">@style/Widget.Hud.Button</item>
        <item name="android:editTextStyle">@style/Widget.Hud.EditText</item>
        <item name="editTextStyle">@style/Widget.Hud.EditText</item>
        <item name="tabStyle">@style/Widget.Hud.Tabs</item>
        <item name="android:switchStyle">@style/Widget.Hud.Switch</item>
        <item name="switchStyle">@style/Widget.Hud.Switch</item>
        <item name="android:spinnerStyle">@style/Widget.Hud.Spinner</item>
        <item name="materialAlertDialogTheme">@style/ThemeOverlay.Hud.Dialog</item>
    </style>

    <style name="Widget.Hud.TextView" parent="Widget.AppCompat.TextView">
        <item name="android:textColor">@color/hud_text</item>
        <item name="android:textSize">13sp</item>
        <item name="android:lineSpacingExtra">3dp</item>
        <item name="android:fontFamily">@font/commit_mono</item>
    </style>

    <style name="Widget.Hud.Button" parent="Widget.Material3.Button.OutlinedButton">
        <item name="backgroundTint">@color/hud_button_fill</item>
        <item name="strokeColor">@color/hud_button_stroke</item>
        <item name="strokeWidth">1dp</item>
        <item name="cornerRadius">6dp</item>
        <item name="rippleColor">@color/hud_glow</item>
        <item name="android:textColor">@color/hud_button_text</item>
        <item name="android:fontFamily">@font/commit_mono</item>
        <item name="android:textSize">12sp</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:letterSpacing">0.06</item>
        <item name="android:maxLines">1</item>
        <item name="autoSizeTextType">uniform</item>
        <item name="autoSizeMinTextSize">9sp</item>
        <item name="autoSizeMaxTextSize">12sp</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:insetTop">3dp</item>
        <item name="android:insetBottom">3dp</item>
        <item name="android:paddingStart">12dp</item>
        <item name="android:paddingEnd">12dp</item>
    </style>

    <!-- Primary call-to-action (Start call, Send, SOS confirm): filled cyan. -->
    <style name="Widget.Hud.Button.Primary">
        <item name="backgroundTint">@color/hud_cyan</item>
        <item name="strokeColor">@color/hud_cyan</item>
        <item name="android:textColor">@color/hud_bg</item>
    </style>

    <style name="Widget.Hud.EditText" parent="Widget.AppCompat.EditText">
        <item name="android:background">@drawable/hud_field</item>
        <item name="android:textColor">@color/hud_text_bright</item>
        <item name="android:textColorHint">@color/hud_text_faint</item>
        <item name="android:textSize">14sp</item>
        <item name="android:fontFamily">@font/commit_mono</item>
        <item name="android:minHeight">48dp</item>
    </style>

    <style name="Widget.Hud.Tabs" parent="Widget.Material3.TabLayout">
        <item name="android:background">@android:color/transparent</item>
        <item name="tabIndicatorColor">@color/hud_cyan</item>
        <item name="tabIndicatorHeight">2dp</item>
        <item name="tabIndicatorFullWidth">false</item>
        <item name="tabTextColor">@color/hud_tab_text</item>
        <item name="tabRippleColor">@color/hud_glow</item>
        <item name="tabTextAppearance">@style/TextAppearance.Hud.Tab</item>
        <item name="tabMinWidth">72dp</item>
    </style>

    <style name="Widget.Hud.Switch" parent="android:Widget.Material.CompoundButton.Switch">
        <item name="android:textColor">@color/hud_text</item>
        <item name="android:textSize">13sp</item>
        <item name="android:fontFamily">@font/commit_mono</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:showText">false</item>
        <item name="android:thumbTint">@color/hud_switch_thumb</item>
        <item name="android:trackTint">@color/hud_switch_track</item>
        <item name="android:trackTintMode">src_over</item>
    </style>

    <style name="Widget.Hud.Spinner" parent="Widget.AppCompat.Spinner.Underlined">
        <item name="android:minHeight">48dp</item>
    </style>

    <style name="ThemeOverlay.Hud.Dialog" parent="ThemeOverlay.Material3.MaterialAlertDialog">
        <item name="colorSurface">@color/hud_bg_raised</item>
        <item name="colorPrimary">@color/hud_cyan</item>
        <item name="android:fontFamily">@font/commit_mono</item>
    </style>

    <!-- Section label: small, spaced, uppercase, dim cyan (desktop .hud panel titles). -->
    <style name="TextAppearance.Hud.Label" parent="TextAppearance.Material3.LabelSmall">
        <item name="android:textColor">@color/hud_text_dim</item>
        <item name="android:textSize">11sp</item>
        <item name="android:letterSpacing">0.18</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:fontFamily">@font/commit_mono</item>
    </style>

    <!-- Primary status line in a panel (link state, call state). -->
    <style name="TextAppearance.Hud.Status" parent="TextAppearance.Material3.TitleMedium">
        <item name="android:textColor">@color/hud_text_bright</item>
        <item name="android:textSize">16sp</item>
        <item name="android:fontFamily">@font/everett_light</item>
    </style>

    <!-- Secondary detail / notices. -->
    <style name="TextAppearance.Hud.Detail" parent="TextAppearance.Material3.BodySmall">
        <item name="android:textColor">@color/hud_text_dim</item>
        <item name="android:textSize">12sp</item>
        <item name="android:fontFamily">@font/commit_mono</item>
    </style>

    <!-- Feeds and logs (captions, chat, actions). -->
    <style name="TextAppearance.Hud.Log" parent="TextAppearance.Material3.BodyMedium">
        <item name="android:textColor">@color/hud_text</item>
        <item name="android:textSize">12sp</item>
        <item name="android:lineSpacingExtra">4dp</item>
        <item name="android:fontFamily">@font/commit_mono</item>
    </style>

    <style name="TextAppearance.Hud.Tab" parent="TextAppearance.Material3.LabelLarge">
        <item name="android:textSize">12sp</item>
        <item name="android:letterSpacing">0.12</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:fontFamily">@font/commit_mono</item>
    </style>

    <!-- Wordmark in the app bar. -->
    <style name="TextAppearance.Hud.Brand" parent="TextAppearance.Material3.TitleMedium">
        <item name="android:textColor">@color/hud_text_bright</item>
        <item name="android:textSize">15sp</item>
        <item name="android:letterSpacing">0.2</item>
        <item name="android:fontFamily">@font/commit_mono</item>
    </style>
</resources>
