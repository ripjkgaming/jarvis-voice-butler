<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp">
    <androidx.camera.view.PreviewView
        android:id="@+id/camera_preview"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">
        <Button android:id="@+id/camera_btn_capture" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="Send photo to PC" />
        <Button android:id="@+id/camera_btn_latest" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="Show latest on PC" />
    </LinearLayout>
    <TextView android:id="@+id/camera_notice" android:layout_width="match_parent" android:layout_height="wrap_content" />
    <ImageView android:id="@+id/camera_image" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:scaleType="fitCenter" android:contentDescription="Latest frame on the PC" />
</LinearLayout>
