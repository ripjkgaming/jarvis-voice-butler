<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:gravity="center" android:padding="28dp" android:background="@drawable/call_gradient">
<TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="JARVIS" android:gravity="center" android:textAppearance="@style/TextAppearance.Hud.Brand"/>
<dev.jarvis.link.ui.ArcReactorView android:layout_width="match_parent" android:layout_height="240dp"/>
<TextView android:id="@+id/incoming_status" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Incoming private voice call" android:gravity="center" android:textAppearance="@style/TextAppearance.Hud.Detail" android:padding="4dp"/>
<TextView android:id="@+id/incoming_reason" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="" android:gravity="center" android:textAppearance="@style/TextAppearance.Hud.Detail" android:padding="4dp"/>
<Button android:id="@+id/incoming_accept" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Answer"/>
<Button android:id="@+id/incoming_decline" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Decline"/>
</LinearLayout>