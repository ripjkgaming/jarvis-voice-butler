<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="#000000"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true">

    <!-- Living HUD backdrop; every tab floats translucent above it. -->
    <dev.jarvis.link.HudBackdropView
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <LinearLayout android:orientation="vertical"
        android:background="@android:color/transparent"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <FrameLayout
            android:id="@+id/fragment_host"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <!-- Six destinations exceeds BottomNavigationView's hard limit of 5
             (it throws at inflate). Scrollable TabLayout holds them all. -->
        <com.google.android.material.tabs.TabLayout
            android:id="@+id/bottom_nav"
            android:background="#CC05070D"
            app:tabMode="scrollable"
            app:tabTextColor="#5A7A8C"
            app:tabSelectedTextColor="#1FD5F9"
            app:tabIndicatorColor="#1FD5F9"
            app:tabIndicatorHeight="2dp"
            app:tabRippleColor="#331FD5F9"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />
    </LinearLayout>
</FrameLayout>
