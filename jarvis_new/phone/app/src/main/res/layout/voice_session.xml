<?xml version="1.0" encoding="utf-8"?>
<!-- Assistant voice plate: orb + status + transcript + listen/close. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="20dp"
    android:background="#CC0A1420">

    <dev.jarvis.link.OrbView
        android:id="@+id/session_orb"
        android:layout_width="160dp"
        android:layout_height="160dp"
        android:layout_gravity="center_horizontal" />

    <TextView
        android:id="@+id/session_status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:gravity="center"
        android:text="At your service, Sir…"
        android:textColor="#7DF9FF"
        android:textSize="18sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/session_transcript"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:maxLines="8"
        android:text="Tap Listen, then speak."
        android:textColor="#C9E8EF"
        android:textSize="14sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:gravity="center"
        android:orientation="horizontal">

        <Button
            android:id="@+id/session_listen"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Listen" />

        <Button
            android:id="@+id/session_close"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:text="Dismiss" />
    </LinearLayout>
</LinearLayout>
