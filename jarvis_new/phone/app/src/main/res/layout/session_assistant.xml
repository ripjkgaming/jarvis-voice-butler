<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="16dp"
    android:background="?android:attr/colorBackground">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:background="@drawable/hud_panel" android:padding="14dp" android:layout_marginTop="4dp">
        <TextView android:textAppearance="@style/TextAppearance.Hud.Status" android:id="@+id/session_status" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Jarvis" android:textStyle="bold" />
        <TextView android:textAppearance="@style/TextAppearance.Hud.Log" android:id="@+id/session_transcript" android:layout_width="match_parent" android:layout_height="wrap_content" />
        <Button android:id="@+id/session_listen" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Listen" />
        <Button android:id="@+id/session_close" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Close" />
    </LinearLayout>
</LinearLayout>
