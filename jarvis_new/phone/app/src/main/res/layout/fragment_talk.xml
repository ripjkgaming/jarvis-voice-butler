<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical" android:gravity="center_horizontal"
    android:padding="24dp"
    android:layout_width="match_parent" android:layout_height="match_parent">
    <dev.jarvis.link.OrbView android:id="@+id/orb"
        android:layout_width="220dp" android:layout_height="220dp" />
    <TextView android:id="@+id/txt_talk_out"
        android:text="Hold the button and speak"
        android:minHeight="120dp"
        android:layout_width="match_parent" android:layout_height="wrap_content" />
    <Button android:id="@+id/btn_ptt" android:text="HOLD TO TALK"
        android:layout_width="220dp" android:layout_height="96dp" />
</LinearLayout>
