<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent">
<LinearLayout android:orientation="vertical" android:padding="16dp"
    android:background="@drawable/hud_panel"
    android:layout_width="match_parent" android:layout_height="wrap_content">
    <TextView android:text="PC tailnet IP"
        android:layout_width="match_parent" android:layout_height="wrap_content" />
    <EditText android:id="@+id/edit_host" android:hint="100.x.x.x" android:inputType="text"
        android:layout_width="match_parent" android:layout_height="wrap_content" />
    <TextView android:text="Bridge port"
        android:layout_width="match_parent" android:layout_height="wrap_content" />
    <EditText android:id="@+id/edit_port" android:text="4317" android:inputType="number"
        android:layout_width="match_parent" android:layout_height="wrap_content" />
    <TextView android:text="Mic uplink port"
        android:layout_width="match_parent" android:layout_height="wrap_content" />
    <EditText android:id="@+id/edit_mic_port" android:text="4318" android:inputType="number"
        android:layout_width="match_parent" android:layout_height="wrap_content" />
    <TextView android:text="Bridge token"
        android:layout_width="match_parent" android:layout_height="wrap_content" />
    <EditText android:id="@+id/edit_token" android:hint="must match JARVIS_BRIDGE_TOKEN"
        android:layout_width="match_parent" android:layout_height="wrap_content" />
    <Button android:id="@+id/btn_save" android:text="Save"
        android:layout_width="match_parent" android:layout_height="wrap_content" />
    <Switch android:id="@+id/switch_mic" android:text="Background mic (hey Jarvis)"
        android:layout_width="match_parent" android:layout_height="wrap_content" />
    <Switch android:id="@+id/switch_hotword" android:text="On-device hotword (Jarvis)"
        android:layout_width="match_parent" android:layout_height="wrap_content" />
    <Switch android:id="@+id/switch_pause_music" android:text="Pause hotword on music"
        android:layout_width="match_parent" android:layout_height="wrap_content" />
    <Switch android:id="@+id/switch_tts" android:text="Speak replies (TTS)"
        android:layout_width="match_parent" android:layout_height="wrap_content" />
    <Switch android:id="@+id/switch_tts_male" android:text="Male, focus-friendly voice"
        android:layout_width="match_parent" android:layout_height="wrap_content" />
    <Switch android:id="@+id/switch_autostart" android:text="Autostart on boot"
        android:layout_width="match_parent" android:layout_height="wrap_content" />
    <Switch android:id="@+id/switch_offline" android:text="Offline mode (hold bridge calls)"
        android:layout_width="match_parent" android:layout_height="wrap_content" />
    <Switch android:id="@+id/switch_guest" android:text="Guest mode (cold, Q&amp;A + media only)"
        android:layout_width="match_parent" android:layout_height="wrap_content" />
    <TextView android:text="Remote desktop app"
        android:layout_marginTop="12dp"
        android:layout_width="match_parent" android:layout_height="wrap_content" />
    <Spinner android:id="@+id/spinner_remote_client"
        android:layout_width="match_parent" android:layout_height="wrap_content" />
    <Button android:id="@+id/btn_remote_start" android:text="Start remote session"
        android:layout_width="match_parent" android:layout_height="wrap_content" />
    <TextView android:id="@+id/txt_session" android:text=""
        android:layout_width="match_parent" android:layout_height="wrap_content" />
    <Button android:id="@+id/btn_test" android:text="Test connection"
        android:layout_width="match_parent" android:layout_height="wrap_content" />
    <TextView android:id="@+id/txt_settings_status" android:text=""
        android:layout_width="match_parent" android:layout_height="wrap_content" />
</LinearLayout>
</ScrollView>
