<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical" android:padding="16dp"
    android:background="@drawable/hud_panel"
    android:layout_width="match_parent" android:layout_height="match_parent">
    <TextView android:text="Pending approvals (on this phone — the server queue needs a bridge endpoint)."
        android:layout_width="match_parent" android:layout_height="wrap_content" />
    <androidx.recyclerview.widget.RecyclerView android:id="@+id/approvals_list"
        android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" />
    <Button android:id="@+id/approvals_demo" android:text="Demo approval"
        android:layout_width="match_parent" android:layout_height="wrap_content" />
</LinearLayout>
