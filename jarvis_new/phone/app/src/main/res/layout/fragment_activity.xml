<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">
        <Button android:id="@+id/activity_btn_refresh" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Refresh" />
        <TextView android:id="@+id/activity_error" android:layout_width="match_parent" android:layout_height="wrap_content" android:textIsSelectable="true" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:text="System" android:textStyle="bold" />
        <TextView android:id="@+id/activity_system" android:layout_width="match_parent" android:layout_height="wrap_content" android:textIsSelectable="true" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:text="Actions (newest last)" android:textStyle="bold" />
        <TextView android:id="@+id/activity_actions" android:layout_width="match_parent" android:layout_height="wrap_content" android:textIsSelectable="true" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:text="Captions (newest last)" android:textStyle="bold" />
        <TextView android:id="@+id/activity_captions" android:layout_width="match_parent" android:layout_height="wrap_content" android:textIsSelectable="true" />
    </LinearLayout>
</ScrollView>
