<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:text="Display" android:textStyle="bold" />
        <RadioGroup android:id="@+id/screens_outputs" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
            <Button android:id="@+id/screens_btn_capture" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="Screenshot" />
            <Button android:id="@+id/screens_btn_refresh" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="Refresh displays" />
        </LinearLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
            <Button android:id="@+id/screens_btn_off" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="Screens off" />
            <Button android:id="@+id/screens_btn_on" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="Screens on" />
        </LinearLayout>
        <TextView android:id="@+id/screens_notice" android:layout_width="match_parent" android:layout_height="wrap_content" android:textIsSelectable="true" />
        <ImageView android:id="@+id/screens_image" android:layout_width="match_parent" android:layout_height="240dp" android:scaleType="fitCenter" android:contentDescription="Latest PC screenshot" />
    </LinearLayout>
</ScrollView>
