<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true">
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="20dp" android:background="@drawable/call_gradient">
<TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="JARVIS • VOICE" android:gravity="center" android:textAppearance="@style/TextAppearance.Hud.Label"/>
<dev.jarvis.link.ui.ArcReactorView android:id="@+id/voice_reactor" android:layout_width="match_parent" android:layout_height="220dp" />
<TextView android:id="@+id/voice_state" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="" android:gravity="center" android:textAppearance="@style/TextAppearance.Hud.Detail" android:padding="4dp"/>
<TextView android:id="@+id/voice_detail" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="" android:gravity="center" android:textAppearance="@style/TextAppearance.Hud.Detail" android:padding="4dp"/>
<TextView android:id="@+id/voice_speaking" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="" android:gravity="center" android:textAppearance="@style/TextAppearance.Hud.Detail" android:padding="4dp"/>
<TextView android:id="@+id/voice_notice" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="" android:gravity="center" android:textAppearance="@style/TextAppearance.Hud.Detail" android:padding="4dp"/>
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:background="@drawable/hud_panel" android:padding="16dp" android:layout_marginTop="20dp">
<TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="LIVE TRANSCRIPT" android:textAppearance="@style/TextAppearance.Hud.Label"/>
<TextView android:id="@+id/voice_captions" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Your conversation appears here" android:gravity="center" android:textAppearance="@style/TextAppearance.Hud.Detail" android:padding="4dp"/>
</LinearLayout>
<Button android:id="@+id/voice_btn_speaker" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Speaker"/>
<Button android:id="@+id/voice_btn_talk" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Start call"/>
<Button android:id="@+id/voice_btn_mute" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Mute"/>
<TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="INCOMING CALLS" android:textAppearance="@style/TextAppearance.Hud.Label" android:layout_marginTop="24dp"/>
<TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="School quiet hours always on
Mon–Fri 08:00–15:30 • Singapore
No queued rings • Up to 3 calls per day" android:textAppearance="@style/TextAppearance.Hud.Detail"/>
<Switch android:id="@+id/voice_incoming" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Receive Jarvis calls"/>
<Switch android:id="@+id/voice_calendar" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Calendar reminders"/>
<Switch android:id="@+id/voice_updates" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Finished job updates"/>
<Switch android:id="@+id/voice_checkin" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Wednesday check-in · 7:05 PM Singapore"/>
<TextView android:id="@+id/voice_incoming_status" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="" android:gravity="center" android:textAppearance="@style/TextAppearance.Hud.Detail" android:padding="4dp"/>
<Button android:id="@+id/voice_btn_notification" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Incoming call notification settings"/>
<Button android:id="@+id/voice_btn_fullscreen" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Full screen call permission"/>
<Button android:id="@+id/voice_btn_laptop" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Join laptop call"/>
<Button android:id="@+id/voice_btn_summon" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Summon laptop"/>
<Button android:id="@+id/voice_btn_refresh" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Refresh transcript"/>
</LinearLayout></ScrollView>