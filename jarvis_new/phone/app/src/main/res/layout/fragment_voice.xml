<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:fillViewport="true">
<LinearLayout android:orientation="vertical" android:padding="16dp"
    android:layout_width="match_parent" android:layout_height="wrap_content">
    <TextView android:text="VOICE UPLINK"
        android:textSize="12sp" android:textColor="@color/jarvis_cyan"
        android:fontFamily="monospace" android:letterSpacing="0.2"
        android:layout_width="wrap_content" android:layout_height="wrap_content" />
    <TextView android:text="LiveKit · low-latency channel"
        android:textSize="12sp" android:textColor="@color/hud_dim"
        android:fontFamily="monospace"
        android:layout_width="wrap_content" android:layout_height="wrap_content" />
    <TextView android:id="@+id/voice_state" android:text="IDLE"
        android:textSize="11sp" android:textColor="@color/jarvis_cyan"
        android:fontFamily="monospace" android:letterSpacing="0.2"
        android:background="@drawable/hud_panel" android:padding="8dp"
        android:layout_marginTop="8dp"
        android:layout_width="wrap_content" android:layout_height="wrap_content" />
    <dev.jarvis.link.ArcReactorView android:id="@+id/voice_orb"
        android:layout_width="260dp" android:layout_height="260dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="8dp" android:layout_marginBottom="8dp" />
    <TextView android:id="@+id/voice_speaking" android:text="○ STANDBY"
        android:textSize="11sp" android:textColor="@color/hud_dim"
        android:fontFamily="monospace" android:gravity="center"
        android:layout_width="match_parent" android:layout_height="wrap_content" />
    <TextView android:id="@+id/voice_detail" android:text="Tap to summon Jarvis"
        android:textSize="11sp" android:textColor="@color/hud_dim"
        android:fontFamily="monospace" android:gravity="center"
        android:layout_marginTop="4dp" android:layout_marginBottom="8dp"
        android:layout_width="match_parent" android:layout_height="wrap_content" />
    <LinearLayout android:orientation="horizontal" android:gravity="center"
        android:layout_width="match_parent" android:layout_height="wrap_content">
        <Button android:id="@+id/btn_voice_talk" android:text="◉ TALK"
            android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" />
        <Button android:id="@+id/btn_voice_mute" android:text="MUTE"
            android:layout_width="wrap_content" android:layout_height="wrap_content" />
    </LinearLayout>
    <LinearLayout android:orientation="horizontal"
        android:layout_width="match_parent" android:layout_height="wrap_content">
        <Button android:id="@+id/btn_voice_room" android:text="JOIN LAPTOP CALL"
            android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" />
        <Button android:id="@+id/btn_voice_summon" android:text="SUMMON LAPTOP"
            android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" />
    </LinearLayout>
    <TextView android:text="LIVE TRANSCRIPT"
        android:textSize="11sp" android:textColor="@color/hud_dim"
        android:fontFamily="monospace" android:letterSpacing="0.2"
        android:layout_marginTop="12dp" android:layout_marginBottom="4dp"
        android:layout_width="wrap_content" android:layout_height="wrap_content" />
    <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
        android:id="@+id/voice_swipe"
        android:layout_width="match_parent" android:layout_height="280dp">
        <androidx.recyclerview.widget.RecyclerView android:id="@+id/voice_captions"
            android:layout_width="match_parent" android:layout_height="match_parent" />
    </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>
    <TextView android:id="@+id/voice_status" android:text=""
        android:textSize="12sp" android:fontFamily="monospace"
        android:layout_marginTop="8dp"
        android:layout_width="match_parent" android:layout_height="wrap_content" />
</LinearLayout>
</ScrollView>
