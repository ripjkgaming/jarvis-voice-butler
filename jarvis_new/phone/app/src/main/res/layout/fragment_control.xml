<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent">
<LinearLayout android:orientation="vertical" android:padding="16dp"
    android:layout_width="match_parent" android:layout_height="wrap_content">
    <LinearLayout android:orientation="horizontal"
        android:layout_width="match_parent" android:layout_height="wrap_content">
        <Button android:id="@+id/btn_vol_down" android:text="Vol −" android:layout_weight="1"
            android:layout_width="0dp" android:layout_height="wrap_content" />
        <Button android:id="@+id/btn_vol_up" android:text="Vol +" android:layout_weight="1"
            android:layout_width="0dp" android:layout_height="wrap_content" />
        <Button android:id="@+id/btn_vol_mute" android:text="Mute" android:layout_weight="1"
            android:layout_width="0dp" android:layout_height="wrap_content" />
    </LinearLayout>
    <LinearLayout android:orientation="horizontal"
        android:layout_width="match_parent" android:layout_height="wrap_content">
        <Button android:id="@+id/btn_media" android:text="▶⏸" android:layout_weight="1"
            android:layout_width="0dp" android:layout_height="wrap_content" />
        <Button android:id="@+id/btn_media_next" android:text="⏭" android:layout_weight="1"
            android:layout_width="0dp" android:layout_height="wrap_content" />
        <Button android:id="@+id/btn_open_app" android:text="Open app" android:layout_weight="1"
            android:layout_width="0dp" android:layout_height="wrap_content" />
    </LinearLayout>
    <Button android:id="@+id/btn_shot" android:text="Screenshot PC"
        android:layout_width="match_parent" android:layout_height="wrap_content" />
    <ImageView android:id="@+id/img_shot" android:adjustViewBounds="true"
        android:layout_width="match_parent" android:layout_height="wrap_content" />
    <LinearLayout android:orientation="horizontal"
        android:layout_width="match_parent" android:layout_height="wrap_content">
        <Button android:id="@+id/btn_notify" android:text="Ping PC" android:layout_weight="1"
            android:layout_width="0dp" android:layout_height="wrap_content" />
        <Button android:id="@+id/btn_lock" android:text="Lock PC" android:layout_weight="1"
            android:layout_width="0dp" android:layout_height="wrap_content" />
        <Button android:id="@+id/btn_unlock" android:text="Unlock" android:layout_weight="1"
            android:layout_width="0dp" android:layout_height="wrap_content" />
    </LinearLayout>
    <LinearLayout android:orientation="horizontal"
        android:layout_width="match_parent" android:layout_height="wrap_content">
        <Button android:id="@+id/btn_blackout" android:text="Blackout screens" android:layout_weight="1"
            android:layout_width="0dp" android:layout_height="wrap_content" />
        <Button android:id="@+id/btn_restore" android:text="Restore screens" android:layout_weight="1"
            android:layout_width="0dp" android:layout_height="wrap_content" />
    </LinearLayout>
    <TextView android:id="@+id/txt_control_status" android:text=""
        android:layout_width="match_parent" android:layout_height="wrap_content" />
</LinearLayout>
</ScrollView>
