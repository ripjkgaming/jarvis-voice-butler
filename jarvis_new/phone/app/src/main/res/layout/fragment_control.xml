<?xml version="1.0" encoding="utf-8"?>
<androidx.swiperefreshlayout.widget.SwipeRefreshLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/ctrl_swipe"
    android:layout_width="match_parent" android:layout_height="match_parent">
<ScrollView
    android:layout_width="match_parent" android:layout_height="match_parent">
<LinearLayout android:orientation="vertical" android:padding="16dp"
    android:background="@drawable/hud_panel"
    android:layout_width="match_parent" android:layout_height="wrap_content">
    <TextView android:text="SYSTEMS CONTROL"
        android:textSize="12sp" android:textColor="@color/jarvis_cyan"
        android:fontFamily="monospace" android:letterSpacing="0.2"
        android:layout_width="wrap_content" android:layout_height="wrap_content" />
    <TextView android:id="@+id/ctrl_sub" android:text="Audio live"
        android:textSize="12sp" android:textColor="@color/hud_dim"
        android:fontFamily="monospace"
        android:layout_marginBottom="8dp"
        android:layout_width="wrap_content" android:layout_height="wrap_content" />
    <!-- Volume: slider with bridge read-back + mute -->
    <TextView android:text="VOLUME"
        android:textSize="11sp" android:textColor="@color/hud_dim"
        android:fontFamily="monospace" android:letterSpacing="0.2"
        android:layout_width="wrap_content" android:layout_height="wrap_content" />
    <LinearLayout android:orientation="horizontal" android:gravity="center_vertical"
        android:layout_width="match_parent" android:layout_height="wrap_content">
        <Button android:id="@+id/btn_vol_mute" android:text="MUTE"
            android:layout_width="wrap_content" android:layout_height="wrap_content" />
        <SeekBar android:id="@+id/ctrl_volume" android:max="100" android:progress="50"
            android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" />
        <TextView android:id="@+id/ctrl_volume_label" android:text="50%"
            android:textSize="12sp" android:textColor="@color/jarvis_cyan"
            android:fontFamily="monospace" android:minWidth="44dp" android:gravity="end"
            android:layout_width="wrap_content" android:layout_height="wrap_content" />
    </LinearLayout>
    <LinearLayout android:orientation="horizontal"
        android:layout_width="match_parent" android:layout_height="wrap_content">
        <Button android:id="@+id/btn_vol_down" android:text="Vol −" android:layout_weight="1"
            android:layout_width="0dp" android:layout_height="wrap_content" />
        <Button android:id="@+id/btn_vol_up" android:text="Vol +" android:layout_weight="1"
            android:layout_width="0dp" android:layout_height="wrap_content" />
    </LinearLayout>
    <!-- Media transport -->
    <TextView android:text="MEDIA"
        android:textSize="11sp" android:textColor="@color/hud_dim"
        android:fontFamily="monospace" android:letterSpacing="0.2"
        android:layout_marginTop="8dp"
        android:layout_width="wrap_content" android:layout_height="wrap_content" />
    <LinearLayout android:orientation="horizontal"
        android:layout_width="match_parent" android:layout_height="wrap_content">
        <Button android:id="@+id/btn_media_prev" android:text="⏮" android:layout_weight="1"
            android:layout_width="0dp" android:layout_height="wrap_content" />
        <Button android:id="@+id/btn_media" android:text="▶⏸" android:layout_weight="1"
            android:layout_width="0dp" android:layout_height="wrap_content" />
        <Button android:id="@+id/btn_media_next" android:text="⏭" android:layout_weight="1"
            android:layout_width="0dp" android:layout_height="wrap_content" />
    </LinearLayout>
    <TextView android:id="@+id/ctrl_now_playing" android:text=""
        android:textSize="12sp" android:textColor="@color/hud_dim"
        android:fontFamily="monospace" android:gravity="center"
        android:layout_width="match_parent" android:layout_height="wrap_content" />
    <!-- Screens: capture + preview + power -->
    <TextView android:text="SCREENS"
        android:textSize="11sp" android:textColor="@color/hud_dim"
        android:fontFamily="monospace" android:letterSpacing="0.2"
        android:layout_marginTop="8dp"
        android:layout_width="wrap_content" android:layout_height="wrap_content" />
    <ImageView android:id="@+id/img_shot" android:adjustViewBounds="true"
        android:background="@drawable/hud_panel" android:padding="6dp"
        android:layout_width="match_parent" android:layout_height="wrap_content" />
    <TextView android:id="@+id/ctrl_note" android:text=""
        android:textSize="10sp" android:textColor="@color/hud_dim"
        android:fontFamily="monospace"
        android:layout_width="match_parent" android:layout_height="wrap_content" />
    <LinearLayout android:orientation="horizontal"
        android:layout_width="match_parent" android:layout_height="wrap_content">
        <Button android:id="@+id/btn_shot" android:text="CAPTURE" android:layout_weight="1"
            android:layout_width="0dp" android:layout_height="wrap_content" />
        <Button android:id="@+id/btn_screens_state" android:text="STATE" android:layout_weight="1"
            android:layout_width="0dp" android:layout_height="wrap_content" />
        <Button android:id="@+id/btn_restore" android:text="WAKE" android:layout_weight="1"
            android:layout_width="0dp" android:layout_height="wrap_content" />
        <Button android:id="@+id/btn_blackout" android:text="SLEEP" android:layout_weight="1"
            style="@style/Widget.JarvisLink.HudButton.Red"
            android:layout_width="0dp" android:layout_height="wrap_content" />
    </LinearLayout>
    <!-- Apps: presets + free-text (bridge resolves any app/site) -->
    <TextView android:text="APPS"
        android:textSize="11sp" android:textColor="@color/hud_dim"
        android:fontFamily="monospace" android:letterSpacing="0.2"
        android:layout_marginTop="8dp"
        android:layout_width="wrap_content" android:layout_height="wrap_content" />
    <Button android:id="@+id/btn_open_app" android:text="Open app… (presets)"
        android:layout_width="match_parent" android:layout_height="wrap_content" />
    <LinearLayout android:orientation="horizontal"
        android:layout_width="match_parent" android:layout_height="wrap_content">
        <EditText android:id="@+id/edit_open_app" android:hint="Any app or site…"
            android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" />
        <Button android:id="@+id/btn_open_app_go" android:text="OPEN"
            android:layout_width="wrap_content" android:layout_height="wrap_content" />
    </LinearLayout>
    <!-- Remote keys: type text + Enter -->
    <TextView android:text="REMOTE KEYS"
        android:textSize="11sp" android:textColor="@color/hud_dim"
        android:fontFamily="monospace" android:letterSpacing="0.2"
        android:layout_marginTop="8dp"
        android:layout_width="wrap_content" android:layout_height="wrap_content" />
    <LinearLayout android:orientation="horizontal"
        android:layout_width="match_parent" android:layout_height="wrap_content">
        <EditText android:id="@+id/edit_type_text" android:hint="Type on the PC…"
            android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" />
        <Button android:id="@+id/btn_type_send" android:text="SEND"
            android:layout_width="wrap_content" android:layout_height="wrap_content" />
        <Button android:id="@+id/btn_type_enter" android:text="⏎"
            android:layout_width="wrap_content" android:layout_height="wrap_content" />
    </LinearLayout>
    <!-- PC power -->
    <LinearLayout android:orientation="horizontal"
        android:layout_marginTop="8dp"
        android:layout_width="match_parent" android:layout_height="wrap_content">
        <Button android:id="@+id/btn_notify" android:text="Ping PC" android:layout_weight="1"
            android:layout_width="0dp" android:layout_height="wrap_content" />
        <Button android:id="@+id/btn_lock" android:text="Lock PC" android:layout_weight="1"
            style="@style/Widget.JarvisLink.HudButton.Red"
            android:layout_width="0dp" android:layout_height="wrap_content" />
        <Button android:id="@+id/btn_unlock" android:text="Unlock" android:layout_weight="1"
            android:layout_width="0dp" android:layout_height="wrap_content" />
    </LinearLayout>
    <TextView android:id="@+id/txt_control_status" android:text=""
        android:fontFamily="monospace"
        android:layout_marginTop="8dp"
        android:layout_width="match_parent" android:layout_height="wrap_content" />
</LinearLayout>
</ScrollView>
</androidx.swiperefreshlayout.widget.SwipeRefreshLayout>
