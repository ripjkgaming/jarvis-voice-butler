<?xml version="1.0" encoding="utf-8"?>
<!-- Infinite status pulse: breathe scale + alpha. -->
<set xmlns:android="http://schemas.android.com/apk/res/android"
    android:interpolator="@android:interpolator/fast_out_slow_in">
    <scale android:fromXScale="1" android:toXScale="1.07"
        android:fromYScale="1" android:toYScale="1.07"
        android:pivotX="50%" android:pivotY="50%"
        android:duration="900" android:repeatCount="infinite"
        android:repeatMode="reverse" />
    <alpha android:fromAlpha="1" android:toAlpha="0.7"
        android:duration="900" android:repeatCount="infinite"
        android:repeatMode="reverse" />
</set>
