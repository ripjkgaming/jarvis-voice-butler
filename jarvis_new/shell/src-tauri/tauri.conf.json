{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Jarvis",
  "version": "0.1.0",
  "identifier": "dev.jarvis.shell",
  "build": {
    "devUrl": "http://localhost:4000",
    "frontendDist": "../ui",
    "beforeDevCommand": "",
    "beforeBuildCommand": ""
  },
  "app": {
    "windows": [
      {
        "label": "overlay",
        "title": "Jarvis",
        "url": "index.html",
        "width": 420,
        "height": 640,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "visible": false,
        "skipTaskbar": true
      }
    ],
    "trayIcon": {
      "id": "jarvis-tray",
      "iconPath": "icons/32x32.png",
      "tooltip": "Jarvis",
      "menuOnLeftClick": true
    },
    "security": {
      "csp": "default-src 'self' tauri: asset: http://localhost:4000 ws://127.0.0.1:7880 http://127.0.0.1:*; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline' http://localhost:4000; connect-src 'self' tauri: http://localhost:4000 http://127.0.0.1:* ws://127.0.0.1:7880; font-src 'self' data:; img-src 'self' data:; object-src 'none'; base-uri 'none'; form-action 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["rpm", "appimage"],
    "category": "Utility",
    "shortDescription": "Jarvis voice butler",
    "longDescription": "Offline-first voice butler: hotword summon, local tools, HUD overlay.",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.png"],
    "linux": {
      "rpm": {
        "depends": ["webkit2gtk4.1"]
      },
      "appimage": {
        "bundleMediaFramework": true
      }
    }
  },
  "plugins": {
    "shell": {
      "open": true
    },
    "cli": {
      "description": "Jarvis shell control",
      "args": [
        {
          "name": "command",
          "index": 1,
          "takesValue": false
        }
      ]
    }
  }
}
