{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Jarvis",
  "version": "0.1.0",
  "identifier": "dev.jarvis.shell",
  "build": {
    "devUrl": "http://localhost:4000",
    "frontendDist": "../ui",
    "beforeDevCommand": "",
    "beforeBuildCommand": ""
  },
  "app": {
    "windows": [
      {
        "label": "overlay",
        "title": "Jarvis",
        "url": "index.html",
        "width": 1280,
        "height": 720,
        "minWidth": 960,
        "minHeight": 540,
        "decorations": true,
        "transparent": true,
        "alwaysOnTop": true,
        "visible": false,
        "skipTaskbar": false
      },
      {
        "label": "projects",
        "title": "Jarvis — Project Archive",
        "url": "projects.html",
        "width": 1440,
        "height": 900,
        "minWidth": 1024,
        "minHeight": 640,
        "decorations": true,
        "transparent": false,
        "alwaysOnTop": false,
        "visible": false,
        "skipTaskbar": false
      },
      {
        "label": "globe",
        "title": "God's Eye (display only)",
        "url": "http://127.0.0.1:4001/index.html?ambient=1",
        "width": 1280,
        "height": 800,
        "minWidth": 960,
        "minHeight": 600,
        "decorations": true,
        "transparent": false,
        "alwaysOnTop": false,
        "visible": false,
        "skipTaskbar": false
      }
    ],
    "trayIcon": {
      "id": "jarvis-tray",
      "iconPath": "icons/32x32.png",
      "tooltip": "Jarvis",
      "menuOnLeftClick": true
    },
    "security": {
      "csp": "default-src 'self' tauri: asset: http://localhost:4000 ws://127.0.0.1:7880 http://127.0.0.1:*; script-src 'self' 'unsafe-inline' http://127.0.0.1:4000 http://127.0.0.1:4001; style-src 'self' 'unsafe-inline' http://localhost:4000 http://127.0.0.1:4000 http://127.0.0.1:4001 https://fonts.googleapis.com; connect-src 'self' tauri: http://localhost:4000 http://127.0.0.1:* http://100.77.6.93:* ws://127.0.0.1:7880 https: wss:; font-src 'self' data: http://127.0.0.1:* https://fonts.gstatic.com; img-src 'self' data: http://127.0.0.1:* https: blob:; media-src 'self' data: blob: http://127.0.0.1:* https:; object-src 'none'; base-uri 'none'; form-action 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "rpm",
      "appimage"
    ],
    "category": "Utility",
    "shortDescription": "Jarvis voice butler",
    "longDescription": "Offline-first voice butler: hotword summon, local tools, HUD overlay.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png"
    ],
    "linux": {
      "rpm": {
        "depends": [
          "webkit2gtk4.1"
        ]
      },
      "appimage": {
        "bundleMediaFramework": false
      }
    }
  },
  "plugins": {
    "shell": {
      "open": true
    },
    "updater": {
      "active": true,
      "endpoints": [
        "https://example.invalid/jarvis/updates.json"
      ],
      "pubkey": "UNSET-v1-checks-only-no-signing-yet"
    },
    "cli": {
      "description": "Jarvis shell control",
      "args": [
        {
          "name": "command",
          "index": 1,
          "takesValue": false
        }
      ]
    }
  }
}